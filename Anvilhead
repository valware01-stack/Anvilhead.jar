package com.example.anvilhead.mixin;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.render.LightmapTextureManager;
import net.minecraft.client.texture.NativeImage;
import net.minecraft.util.math.MathHelper;
import net.minecraft.world.World;
import org.spongepowered.asm.mixin.Final;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

/**
 * Makes the Overworld truly pitch black wherever there is no real light source.
 *
 * The lightmap is a 16x16 texture: x = block light (torches etc.), y = sky light.
 * Right before vanilla uploads it, we:
 *   1. subtract the darkest texel (block 0 / sky 0), which removes the Brightness-slider lift ("moody/bright"),
 *   2. crush everything dimmer than DARK_FLOOR to pure black, fading smoothly up to FULL_BRIGHT.
 *
 * Result: a cave with no torches is 0,0,0. Torches / lava / glowstone still work, a dim edge of torch light
 * fades out much sooner than in vanilla, and Night Vision still works (it lifts the values above the crush range).
 * Anything lit only by this black lightmap (terrain, mobs, your own hand) is invisible. Fullbright things,
 * like the Anvilhead's eyes, are not affected.
 */
@Mixin(LightmapTextureManager.class)
public abstract class LightmapTextureManagerMixin {
    // Luminance range (0..1). Below DARK_FLOOR = pure black. Above FULL_BRIGHT = untouched.
    // Raise DARK_FLOOR for a harsher dark, lower it to see torch light farther out.
    private static final float DARK_FLOOR = 0.03f;
    private static final float FULL_BRIGHT = 0.14f;

    @Shadow @Final private NativeImage image;

    @Inject(method = "update", at = @At(value = "INVOKE",
            target = "Lnet/minecraft/client/texture/NativeImageBackedTexture;upload()V"))
    private void anvilhead$crushDarkness(float delta, CallbackInfo ci) {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (mc.world == null || !mc.world.getRegistryKey().equals(World.OVERWORLD)) return;

        int floor = image.getColor(0, 0);
        int fr = floor & 0xFF, fg = (floor >> 8) & 0xFF, fb = (floor >> 16) & 0xFF;

        for (int y = 0; y < 16; y++) {
            for (int x = 0; x < 16; x++) {
                int c = image.getColor(x, y);
                int r = Math.max(0, (c & 0xFF) - fr);
                int g = Math.max(0, ((c >> 8) & 0xFF) - fg);
                int b = Math.max(0, ((c >> 16) & 0xFF) - fb);

                float lum = (r + g + b) / (3f * 255f);
                float t = MathHelper.clamp((lum - DARK_FLOOR) / (FULL_BRIGHT - DARK_FLOOR), 0f, 1f);
                float f = t * t * (3f - 2f * t); // smoothstep

                image.setColor(x, y, (c & 0xFF000000)
                        | ((int) (b * f) << 16) | ((int) (g * f) << 8) | (int) (r * f));
            }
        }
    }
}
