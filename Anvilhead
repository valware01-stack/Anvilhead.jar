package com.example.anvilhead.event;

import com.example.anvilhead.EyeSequence;
import com.example.anvilhead.entity.AnvilheadSpawner;
import com.example.anvilhead.net.EyeEventPayload;
import net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking;
import net.minecraft.server.MinecraftServer;
import net.minecraft.server.network.ServerPlayerEntity;
import net.minecraft.server.world.ServerWorld;
import net.minecraft.sound.SoundCategory;
import net.minecraft.sound.SoundEvents;
import net.minecraft.world.Difficulty;
import net.minecraft.world.World;

import java.util.HashMap;
import java.util.Iterator;
import java.util.Map;
import java.util.UUID;

/**
 * The extremely rare "eyes" event.
 *
 * Every server tick, every Overworld player has a 1 in 1,000,000,000,000 chance of triggering it.
 * Eyes then appear on that player's screen one after another (slow at first, then faster), until there are 50.
 * Then a shockwave wipes them away and an Anvilhead is spawned ~50 blocks from the player, day or night,
 * and it starts chasing immediately.
 */
public final class EyeEventManager {
    /** 1-in-N per player per tick. */
    public static final long ODDS = 1_000_000_000_000L;
    private static final int SPAWN_RETRY_TICKS = 200;

    private static final Map<UUID, Integer> ACTIVE = new HashMap<>();   // player -> ticks since the event started
    private static final Map<UUID, Integer> PENDING = new HashMap<>();  // player -> ticks spent looking for a spawn spot

    private EyeEventManager() {}

    public static boolean isRunning() { return !ACTIVE.isEmpty(); }

    /** Starts the event for this player. Returns false if it can't run right now (one at a time, Overworld, not Peaceful). */
    public static boolean trigger(ServerPlayerEntity p) {
        if (!ACTIVE.isEmpty() || p.isSpectator() || !p.isAlive()) return false;
        if (!(p.getWorld() instanceof ServerWorld w)) return false;
        if (!w.getRegistryKey().equals(World.OVERWORLD) || w.getDifficulty() == Difficulty.PEACEFUL) return false;
        ACTIVE.put(p.getUuid(), 0);
        ServerPlayNetworking.send(p, new EyeEventPayload(EyeEventPayload.START, w.random.nextInt()));
        return true;
    }

    public static void tick(ServerWorld world) {
        if (!world.getRegistryKey().equals(World.OVERWORLD)) return;
        MinecraftServer server = world.getServer();

        // the 1-in-a-trillion roll, every tick, for every player
        if (ACTIVE.isEmpty()) {
            for (ServerPlayerEntity p : world.getPlayers()) {
                if (p.isSpectator() || !p.isAlive()) continue;
                if (Math.floorMod(world.random.nextLong(), ODDS) == 0L && trigger(p)) break;
            }
        }

        // running events
        Iterator<Map.Entry<UUID, Integer>> it = ACTIVE.entrySet().iterator();
        while (it.hasNext()) {
            Map.Entry<UUID, Integer> en = it.next();
            ServerPlayerEntity p = server.getPlayerManager().getPlayer(en.getKey());
            if (p == null || !p.isAlive() || p.isSpectator() || p.getWorld() != world
                    || world.getDifficulty() == Difficulty.PEACEFUL) {
                if (p != null) ServerPlayNetworking.send(p, new EyeEventPayload(EyeEventPayload.CANCEL, 0));
                it.remove();
                continue;
            }
            int t = en.getValue() + 1;
            en.setValue(t);
            if (t >= EyeSequence.shockwaveTick()) {
                it.remove();
                shockwave(world, p);
            }
        }

        // spawn retries (if no valid spot was found the instant the shockwave hit)
        Iterator<Map.Entry<UUID, Integer>> pit = PENDING.entrySet().iterator();
        while (pit.hasNext()) {
            Map.Entry<UUID, Integer> en = pit.next();
            ServerPlayerEntity p = server.getPlayerManager().getPlayer(en.getKey());
            if (p == null || !p.isAlive() || p.getWorld() != world) { pit.remove(); continue; }
            if (AnvilheadSpawner.spawnChaser(world, p)) { pit.remove(); continue; }
            en.setValue(en.getValue() + 1);
            if (en.getValue() > SPAWN_RETRY_TICKS) pit.remove();
        }
    }

    private static void shockwave(ServerWorld world, ServerPlayerEntity p) {
        ServerPlayNetworking.send(p, new EyeEventPayload(EyeEventPayload.SHOCKWAVE, 0));
        world.playSound(null, p.getX(), p.getY(), p.getZ(),
                SoundEvents.ENTITY_WARDEN_SONIC_BOOM, SoundCategory.HOSTILE, 4.0f, 0.5f);
        if (!AnvilheadSpawner.spawnChaser(world, p)) PENDING.put(p.getUuid(), 0);
    }

    public static void reset() {
        ACTIVE.clear();
        PENDING.clear();
    }
