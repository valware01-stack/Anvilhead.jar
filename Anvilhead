package com.example.anvilhead.client;

import com.example.anvilhead.entity.AnvilheadEntity;
import net.minecraft.client.model.*;
import net.minecraft.client.render.VertexConsumer;
import net.minecraft.client.render.entity.model.EntityModel;
import net.minecraft.client.util.math.MatrixStack;
import net.minecraft.util.math.MathHelper;

/**
 * Silhouette from the reference image: a huge flat slab of a head, a face wedge with two tiny eyes,
 * a thin neck, broad shoulders and long arms. Texture is 128x64.
 * Model space: y = 24 is the ground, so higher parts have more negative y.
 */
public class AnvilheadModel extends EntityModel<AnvilheadEntity> {
    private final ModelPart root, head, leftArm, rightArm, leftLeg, rightLeg;

    public AnvilheadModel(ModelPart root) {
        this.root = root;
        this.head = root.getChild("head");
        this.leftArm = root.getChild("left_arm");
        this.rightArm = root.getChild("right_arm");
        this.leftLeg = root.getChild("left_leg");
        this.rightLeg = root.getChild("right_leg");
    }

    public static TexturedModelData getTexturedModelData() {
        ModelData data = new ModelData();
        ModelPartData r = data.getRoot();

        // slab (the anvil top) + face wedge below it; eyes are painted on the face's front
        r.addChild("head", ModelPartBuilder.create()
                .uv(0, 0).cuboid(-14f, -5f, -5f, 28f, 5f, 10f)
                .uv(0, 16).cuboid(-5f, 0f, -4f, 10f, 8f, 8f),
                ModelTransform.pivot(0f, -26f, 0f));

        r.addChild("neck", ModelPartBuilder.create()
                .uv(40, 16).cuboid(-2f, 0f, -2f, 4f, 4f, 4f),
                ModelTransform.pivot(0f, -18f, 0f));

        r.addChild("torso", ModelPartBuilder.create()
                .uv(0, 40).cuboid(-6f, 0f, -3f, 12f, 16f, 6f),
                ModelTransform.pivot(0f, -14f, 0f));

        r.addChild("left_arm", ModelPartBuilder.create()
                .uv(40, 32).cuboid(-1.5f, 0f, -1.5f, 3f, 26f, 3f),
                ModelTransform.pivot(7.5f, -12f, 0f));
        r.addChild("right_arm", ModelPartBuilder.create()
                .uv(56, 32).cuboid(-1.5f, 0f, -1.5f, 3f, 26f, 3f),
                ModelTransform.pivot(-7.5f, -12f, 0f));

        r.addChild("left_leg", ModelPartBuilder.create()
                .uv(80, 32).cuboid(-1.5f, 0f, -1.5f, 3f, 22f, 3f),
                ModelTransform.pivot(2.5f, 2f, 0f));
        r.addChild("right_leg", ModelPartBuilder.create()
                .uv(92, 32).cuboid(-1.5f, 0f, -1.5f, 3f, 22f, 3f),
                ModelTransform.pivot(-2.5f, 2f, 0f));

        return TexturedModelData.of(data, 128, 64);
    }

    @Override
    public void setAngles(AnvilheadEntity e, float limbAngle, float limbDistance,
                          float animationProgress, float headYaw, float headPitch) {
        head.yaw = headYaw * ((float) Math.PI / 180f);
        head.pitch = headPitch * ((float) Math.PI / 180f);

        float swing = limbDistance * 0.5f;
        rightArm.pitch = MathHelper.cos(limbAngle * 0.6662f + (float) Math.PI) * swing;
        leftArm.pitch = MathHelper.cos(limbAngle * 0.6662f) * swing;
        rightLeg.pitch = MathHelper.cos(limbAngle * 0.6662f) * 1.2f * limbDistance;
        leftLeg.pitch = MathHelper.cos(limbAngle * 0.6662f + (float) Math.PI) * 1.2f * limbDistance;

        // slow, unsettling idle sway of the arms
        float sway = MathHelper.cos(animationProgress * 0.067f) * 0.03f;
        leftArm.roll = -0.05f - sway;
        rightArm.roll = 0.05f + sway;

        // ROAR pose: head thrown back and shaking, arms flung wide
        if (e.isRoaring()) {
            float t = animationProgress;
            head.pitch = -0.6f + MathHelper.sin(t * 2.9f) * 0.05f;
            head.yaw += MathHelper.sin(t * 3.7f) * 0.06f;
            leftArm.pitch = -0.3f;
            rightArm.pitch = -0.3f;
            leftArm.roll = -1.15f - MathHelper.sin(t * 3.1f) * 0.05f;
            rightArm.roll = 1.15f + MathHelper.sin(t * 3.1f) * 0.05f;
        }
    }

    @Override
    public void render(MatrixStack matrices, VertexConsumer vertices, int light, int overlay, int color) {
        root.render(matrices, vertices, light, overlay, color);
    }
}

