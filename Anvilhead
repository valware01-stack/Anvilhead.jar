package com.example.anvilhead.client;

import com.example.anvilhead.AnvilheadMod;
import com.example.anvilhead.EyeSequence;
import com.example.anvilhead.net.EyeEventPayload;
import com.mojang.blaze3d.systems.RenderSystem;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
import net.fabricmc.fabric.api.client.rendering.v1.HudRenderCallback;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.render.RenderTickCounter;
import net.minecraft.client.sound.PositionedSoundInstance;
import net.minecraft.sound.SoundEvents;
import net.minecraft.util.Identifier;
import net.minecraft.util.Util;
import net.minecraft.util.math.MathHelper;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Random;

/**
 * Client side of the eyes event: eyes open on your screen one after another (slow, then faster) until there are 50,
 * then a shockwave rolls outward from the centre of the screen, wiping them away while the view kicks and shakes.
 */
public final class EyeEventClient {
    private static final Identifier EYE = Identifier.of(AnvilheadMod.MOD_ID, "textures/gui/eye.png");
    private static final int TEX_W = 208, TEX_H = 128;

    private static boolean active;
    private static int ticks;            // ticks since START
    private static int shockTicks = -1;  // -1 = shockwave hasn't happened yet
    private static int seed;
    private static int soundsPlayed;

    private EyeEventClient() {}

    public static void init() {
        ClientPlayNetworking.registerGlobalReceiver(EyeEventPayload.ID, (payload, context) -> {
            switch (payload.phase()) {
                case EyeEventPayload.START -> {
                    reset();
                    active = true;
                    seed = payload.seed();
                }
                case EyeEventPayload.SHOCKWAVE -> {
                    if (!active) { active = true; seed = payload.seed(); }
                    shockTicks = 0;
                }
                default -> reset();
            }
        });
        ClientTickEvents.END_CLIENT_TICK.register(EyeEventClient::tick);
        HudRenderCallback.EVENT.register(EyeEventClient::render);
        ClientPlayConnectionEvents.DISCONNECT.register((handler, client) -> reset());
    }

    private static void reset() {
        active = false;
        ticks = 0;
        shockTicks = -1;
        soundsPlayed = 0;
    }

    private static void tick(MinecraftClient mc) {
        if (!active) return;
        if (mc.player == null || mc.world == null) { reset(); return; }

        if (shockTicks >= 0) {
            if (++shockTicks > EyeSequence.SHOCK_LENGTH) reset();
            return;
        }
        ticks++;

        // a heartbeat for every new eye: gets louder, deeper and (because the gaps shrink) faster
        int n = EyeSequence.eyesVisible(ticks);
        while (soundsPlayed < n) {
            float f = soundsPlayed / (float) (EyeSequence.EYES - 1);
            mc.getSoundManager().play(PositionedSoundInstance.master(
                    SoundEvents.ENTITY_WARDEN_HEARTBEAT, 0.55f + 0.7f * f, 0.35f + 0.65f * f));
            soundsPlayed++;
        }
    }

    /** 0..1 progress of the shockwave, or -1 if it hasn't happened. */
    private static float shockProgress(float tickDelta) {
        if (!active || shockTicks < 0) return -1f;
        return MathHelper.clamp((shockTicks + tickDelta) / EyeSequence.SHOCK_LENGTH, 0f, 1f);
    }

    // ---- view effects (called from the mixins) ----

    /** The field of view snaps, then rubber-bands back, as the shockwave passes. */
    public static double applyFov(double fov, float tickDelta) {
        float t = shockProgress(tickDelta);
        if (t < 0f) return fov;
        double wobble = Math.exp(-4.0 * t) * Math.sin(t * 22.0);
        return fov * (1.0 - 0.28 * wobble);
    }

    /** Hard camera shake at the moment of impact that dies out. {yaw, pitch} offsets in degrees, or null. */
    public static float[] shakeOffsets(float tickDelta) {
        float t = shockProgress(tickDelta);
        if (t < 0f || t > 0.6f) return null;
        float a = (1f - t / 0.6f) * 3.0f;
        double time = Util.getMeasuringTimeMs() / 1000.0;
        float yaw = (float) (Math.sin(time * 55.0) * 0.6 + Math.sin(time * 91.0 + 1.0) * 0.4);
        float pitch = (float) (Math.sin(time * 63.0 + 2.0) * 0.6 + Math.sin(time * 83.0) * 0.4);
        return new float[]{yaw * a, pitch * a};
    }

    // ---- HUD ----

    private static void render(DrawContext ctx, RenderTickCounter counter) {
        if (!active) return;
        float td = counter.getTickDelta(false);
        int w = ctx.getScaledWindowWidth();
        int h = ctx.getScaledWindowHeight();
        float cx = w / 2f, cy = h / 2f;
        float maxR = (float) Math.sqrt(cx * cx + cy * cy);
        float shock = shockProgress(td);
        float ringR = shock < 0f ? -1f : shock * maxR * 1.15f;

        // jittered grid with enough cells for all the eyes, in a seeded random order so they pop up all over the screen
        int rows = Math.max(1, Math.round((float) Math.sqrt(EyeSequence.EYES * (double) h / w)));
        int cols = (int) Math.ceil(EyeSequence.EYES / (double) rows);
        float cellW = w / (float) cols, cellH = h / (float) rows;
        List<Integer> order = new ArrayList<>();
        for (int i = 0; i < cols * rows; i++) order.add(i);
        Collections.shuffle(order, new Random(seed));
        Random r = new Random(seed * 31L + 7L);
        double time = Util.getMeasuringTimeMs() / 1000.0;

        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        for (int i = 0; i < EyeSequence.EYES; i++) {
            int cell = order.get(i);
            // always draw the random numbers in the same order so every eye keeps its place from frame to frame
            float ex = (cell % cols + 0.5f + (r.nextFloat() - 0.5f) * 0.6f) * cellW;
            float ey = (cell / cols + 0.5f + (r.nextFloat() - 0.5f) * 0.6f) * cellH;
            float ew = cellW * (1.25f + r.nextFloat() * 0.55f);
            float eh = ew * TEX_H / (float) TEX_W;

            float alpha = shock >= 0f ? 1f : MathHelper.clamp((ticks + td - EyeSequence.appearTick(i)) / 8f, 0f, 1f);
            if (alpha <= 0f) continue;

            ex += (float) Math.sin(time * 1.3 + i) * 1.5f;   // faint restless drift
            ey += (float) Math.cos(time * 1.1 + i * 2.0) * 1.0f;

            if (shock >= 0f) {
                float dx = ex - cx, dy = ey - cy;
                float dist = Math.max(1f, (float) Math.sqrt(dx * dx + dy * dy));
                if (dist < ringR) continue;                                  // the wave has already passed: gone
                float push = (float) Math.exp(-(dist - ringR) / (maxR * 0.12f));
                ex += dx / dist * push * 30f;                                // eyes just ahead of the wave get shoved outward
                ey += dy / dist * push * 30f;
                ew *= 1f + push * 0.25f;
                eh *= 1f + push * 0.25f;
            }

            RenderSystem.setShaderColor(1f, 1f, 1f, alpha);
            ctx.drawTexture(EYE, Math.round(ex - ew / 2f), Math.round(ey - eh / 2f), Math.round(ew), Math.round(eh),
                    0f, 0f, TEX_W, TEX_H, TEX_W, TEX_H);
        }
        RenderSystem.setShaderColor(1f, 1f, 1f, 1f);
        RenderSystem.disableBlend();

        if (shock < 0f) return;

        // the shockwave: a bright leading edge followed by alternating dark / light bands
        float fade = 1f - shock * 0.8f;
        float band = Math.max(6f, maxR * 0.025f);
        int[] rgb = {0xFFFFFF, 0x000000, 0xFFFFFF, 0x000000, 0xFFFFFF, 0x000000};
        float[] a = {0.70f, 0.55f, 0.30f, 0.40f, 0.15f, 0.25f};
        for (int k = 0; k < rgb.length; k++) {
            float outer = ringR - k * band;
            if (outer <= 0f) break;
            ring(ctx, w, h, cx, cy, outer, band, ((int) (a[k] * fade * 255f) << 24) | rgb[k]);
        }

        // white-out at the moment of impact
        if (shock < 0.12f) {
            int al = (int) ((1f - shock / 0.12f) * 0.9f * 255f);
            ctx.fill(0, 0, w, h, (al << 24) | 0xFFFFFF);
        }
    }

    /** A ring (annulus) built out of horizontal spans, 2 px tall each. */
    private static void ring(DrawContext ctx, int w, int h, float cx, float cy, float outer, float thick, int argb) {
        float inner = Math.max(0f, outer - thick);
        for (int y = 0; y < h; y += 2) {
            float dy = y + 1 - cy;
            if (Math.abs(dy) >= outer) continue;
            float xo = (float) Math.sqrt(outer * outer - dy * dy);
            if (Math.abs(dy) < inner) {
                float xi = (float) Math.sqrt(inner * inner - dy * dy);
                span(ctx, w, y, cx - xo, cx - xi, argb);
                span(ctx, w, y, cx + xi, cx + xo, argb);
            } else {
                span(ctx, w, y, cx - xo, cx + xo, argb);
            }
        }
    }

    private static void span(DrawContext ctx, int w, int y, float x0, float x1, int argb) {
        int a = Math.max(0, (int) x0), b = Math.min(w, (int) x1);
        if (b > a) ctx.fill(a, y, b, y + 2, argb);
    }
}

