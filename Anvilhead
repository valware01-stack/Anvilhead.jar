package com.example.anvilhead;

/**
 * Timeline of the "eyes" event (ticks, 20 = 1 s), shared by the server (which decides when the event ends)
 * and the client (which draws the eyes) so they stay in sync.
 *
 * Eye 1 appears after 2 s, then every ~5 s, and the gap shrinks by 6% per eye down to 3 ticks, so the screen
 * fills slowly at first and then faster and faster. 50 eyes take roughly 80 seconds.
 */
public final class EyeSequence {
    public static final int EYES = 50;
    /** Pause after the last eye before the shockwave. */
    public static final int HOLD_AFTER_LAST = 40;
    /** How long the shockwave animation plays on the client. */
    public static final int SHOCK_LENGTH = 50;

    private static final int[] APPEAR = new int[EYES];
    static {
        double gap = 100;      // ticks between eye 1 and eye 2
        int t = 40;            // eye 1
        for (int i = 0; i < EYES; i++) {
            APPEAR[i] = t;
            t += Math.max(3, (int) Math.round(gap));
            gap *= 0.94;       // each gap is 6% shorter than the last
        }
    }

    private EyeSequence() {}

    /** Tick (since the event started) at which eye {@code i} (0-based) appears. */
    public static int appearTick(int i) { return APPEAR[i]; }

    /** The tick at which the shockwave hits and the monster is released. */
    public static int shockwaveTick() { return APPEAR[EYES - 1] + HOLD_AFTER_LAST; }

    /** How many eyes are showing after {@code ticks} ticks. */
    public static int eyesVisible(int ticks) {
        int n = 0;
        while (n < EYES && APPEAR[n] <= ticks) n++;
        return n;
    }
}

package com.example.anvilhead;

import com.example.anvilhead.entity.AnvilheadEntity;
import com.example.anvilhead.entity.AnvilheadSpawner;
import com.example.anvilhead.event.EyeEventManager;
import com.example.anvilhead.net.ChasePhasePayload;
import com.example.anvilhead.net.EyeEventPayload;
import net.fabricmc.api.ModInitializer;
import net.fabricmc.fabric.api.command.v2.CommandRegistrationCallback;
import net.fabricmc.fabric.api.event.lifecycle.v1.ServerEntityEvents;
import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
import net.fabricmc.fabric.api.itemgroup.v1.ItemGroupEvents;
import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
import net.fabricmc.fabric.api.object.builder.v1.entity.FabricDefaultAttributeRegistry;
import net.minecraft.entity.EntityType;
import net.minecraft.entity.SpawnGroup;
import net.minecraft.item.Item;
import net.minecraft.item.ItemGroups;
import net.minecraft.item.SpawnEggItem;
import net.minecraft.registry.Registries;
import net.minecraft.registry.Registry;
import net.minecraft.server.command.CommandManager;
import net.minecraft.server.network.ServerPlayerEntity;
import net.minecraft.text.Text;
import net.minecraft.sound.SoundEvent;
import net.minecraft.util.Identifier;

public class AnvilheadMod implements ModInitializer {
    public static final String MOD_ID = "anvilhead";

    public static final EntityType<AnvilheadEntity> ANVILHEAD = Registry.register(
            Registries.ENTITY_TYPE,
            Identifier.of(MOD_ID, "anvilhead"),
            EntityType.Builder.create(AnvilheadEntity::new, SpawnGroup.MONSTER)
                    .dimensions(0.8f, 4.0f)    // 4 blocks tall
                    .maxTrackingRange(8)
                    .build("anvilhead"));

    public static final Item ANVILHEAD_SPAWN_EGG = Registry.register(
            Registries.ITEM,
            Identifier.of(MOD_ID, "anvilhead_spawn_egg"),
            new SpawnEggItem(ANVILHEAD, 0x0D0D0D, 0xE6E6DC, new Item.Settings()));

    public static final SoundEvent CHASE_THEME = Registry.register(
            Registries.SOUND_EVENT,
            Identifier.of(MOD_ID, "chase_theme"),
            SoundEvent.of(Identifier.of(MOD_ID, "chase_theme")));

    @Override
    public void onInitialize() {
        PayloadTypeRegistry.playS2C().register(ChasePhasePayload.ID, ChasePhasePayload.CODEC);
        PayloadTypeRegistry.playS2C().register(EyeEventPayload.ID, EyeEventPayload.CODEC);
        FabricDefaultAttributeRegistry.register(ANVILHEAD, AnvilheadEntity.createAttributes());
        ItemGroupEvents.modifyEntriesEvent(ItemGroups.SPAWN_EGGS).register(e -> e.add(ANVILHEAD_SPAWN_EGG));
        ServerTickEvents.END_WORLD_TICK.register(AnvilheadSpawner::tick);
        ServerTickEvents.END_WORLD_TICK.register(EyeEventManager::tick);
        net.fabricmc.fabric.api.event.lifecycle.v1.ServerLifecycleEvents.SERVER_STOPPING.register(server -> EyeEventManager.reset());

        // Test commands (op level 2): /anvilhead eyes  -> start the eyes event on yourself
        //                             /anvilhead chase -> spawn it 50 blocks away and start a chase right now
        CommandRegistrationCallback.EVENT.register((dispatcher, registryAccess, environment) ->
                dispatcher.register(CommandManager.literal("anvilhead")
                        .requires(src -> src.hasPermissionLevel(2))
                        .then(CommandManager.literal("eyes").executes(ctx -> {
                            ServerPlayerEntity p = ctx.getSource().getPlayerOrThrow();
                            if (EyeEventManager.trigger(p)) {
                                ctx.getSource().sendFeedback(() -> Text.literal("The eyes are opening..."), false);
                                return 1;
                            }
                            ctx.getSource().sendError(Text.literal("Can't start now (already running, not in the Overworld, or Peaceful)."));
                            return 0;
                        }))
                        .then(CommandManager.literal("chase").executes(ctx -> {
                            ServerPlayerEntity p = ctx.getSource().getPlayerOrThrow();
                            if (p.getWorld() instanceof net.minecraft.server.world.ServerWorld w && AnvilheadSpawner.spawnChaser(w, p)) {
                                return 1;
                            }
                            ctx.getSource().sendError(Text.literal("No valid spot found."));
                            return 0;
                        }))));

        // Hard cap of one: if a second one ever loads in (spawn egg, /summon, chunk reload), it is removed.
        ServerEntityEvents.ENTITY_LOAD.register((entity, world) -> {
            if (entity instanceof AnvilheadEntity && AnvilheadSpawner.anyExists(world.getServer(), entity)) {
                world.getServer().execute(entity::discard);
            }
        });
    }
}

